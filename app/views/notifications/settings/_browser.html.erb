<% unless (platform.safari? || platform.chrome?) && platform.ios? %>
  <div class="notifications-help" data-notifications-target="details">
    <% case
      when platform.firefox? && platform.android? %>
        <h3>Включите уведомления для <%= platform.browser.capitalize %>.</h3>
        <ol>
          <li>Нажмите <em><%= icon_tag "lock", alt: "кнопка просмотра сведений о сайте" %></em> в адресной строке.</li>
          <li>Нажмите <em>Уведомление</em>, чтобы изменить на <em>Разрешено</em>.</li>
        </ol>
      <% when platform.edge? && platform.desktop? %>
        <h3>Включите уведомления для этого сайта.</h3>
        <ol>
          <li>Нажмите <em><%= icon_tag "lock", alt: "кнопка просмотра сведений о сайте" %></em> слева от адресной строки.</li>
          <li>В разделе <em>Разрешения для этого сайта &gt; Уведомления</em> выберите <em>Разрешить</em>.</li>
        </ol>
        <h3>Включите уведомления для <%= platform.browser.capitalize %>.</h3>
        <ol>
          <% if platform.windows? %>
            <li>Нажмите <em>Пуск</em>, затем <em>Параметры</em>.</li>
            <li>Перейдите в <em>Система &gt; Уведомления</em>.</li>
            <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em> <em>ВКЛ</em> для <%= platform.browser.capitalize %>.</li>
          <% else %>
            <li>Нажмите <em aria-label="меню Apple"></em> в левом верхнем углу.</li>
            <li>Нажмите <em>Системные настройки…</em></li>
            <li>Нажмите <em>Уведомления</em>.</li>
            <li>Нажмите <em><%= platform.browser.capitalize %></em>.</li>
            <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em>, чтобы <em>Разрешить уведомления</em>.</li>
          <% end %>
        </ol>
      <% when platform.firefox? && platform.desktop? %>
        <h3>Включите уведомления для этого сайта.</h3>
        <ol>
          <li>Нажмите <em><%= platform.browser.capitalize %></em> в левом верхнем углу.</li>
          <li>Нажмите <em>Настройки…</em></li>
          <li>Нажмите <em>Конфиденциальность и защита</em> на боковой панели.</li>
          <li>Прокрутите вниз до раздела <em>Разрешения</em>.</li>
          <li>Нажмите <em>Настройки</em> рядом с <em>Уведомления</em>.</li>
          <li>Выберите <em>Разрешить</em> рядом с <em><%= root_url %></em>.</li>
        </ol>

        <h3>Включите уведомления для <%= platform.browser.capitalize %>.</h3>
        <ol>
          <% if platform.windows? %>
            <li>Нажмите <em>Пуск</em>, затем <em>Параметры</em>.</li>
            <li>Перейдите в <em>Система &gt; Уведомления</em>.</li>
            <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em> <em>ВКЛ</em> для <%= platform.browser.capitalize %>.</li>
          <% else %>
            <li>Нажмите <em aria-label="меню Apple"></em> в левом верхнем углу.</li>
            <li>Нажмите <em>Системные настройки…</em></li>
            <li>Нажмите <em>Уведомления</em>.</li>
            <li>Нажмите <em><%= platform.browser.capitalize %></em>.</li>
            <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em>, чтобы <em>Разрешить уведомления</em>.</li>
          <% end %>
        </ol>
      <% when platform.chrome? && platform.desktop? %>
        <h3>Включите уведомления для этого сайта.</h3>
        <ol>
          <li>Нажмите значок <em><%= icon_tag "sliders", alt: "Сведения о сайте" %></em> в адресной строке.</li>
          <li>Нажмите <em>Настройки сайта</em>.</li>
          <li>Убедитесь, что уведомления <em>Разрешены</em>.</li>
        </ol>

        <h3>Включите уведомления для <%= platform.browser.capitalize %>.</h3>
        <ol>
          <% if platform.windows? %>
            <li>Нажмите <em>Пуск</em>, затем <em>Параметры</em>.</li>
            <li>Перейдите в <em>Система &gt; Уведомления</em>.</li>
            <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em> <em>ВКЛ</em> для <%= platform.browser.capitalize %>.</li>
          <% else %>
            <li>Нажмите <em aria-label="меню Apple"></em> в левом верхнем углу.</li>
            <li>Нажмите <em>Системные настройки…</em></li>
            <li>Нажмите <em>Уведомления</em>.</li>
            <li>Нажмите <em><%= platform.browser == "Chrome" ? "Google Chrome" : platform.browser.capitalize %></em>.</li>
            <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em>, чтобы <em>Разрешить уведомления</em>.</li>
          <% end %>
        </ol>
      <% when platform.chrome? && platform.android? %>
        <h3>Включите уведомления для <%= platform.browser.capitalize %>.</h3>
        <ol>
          <li>Нажмите кнопку меню <em><%= icon_tag "menu-dots-vertical", alt: "Дополнительные параметры" %></em>.</li>
          <li>Нажмите <em>Настройки</em>.</li>
          <li>Нажмите <em>Уведомления</em>.</li>
          <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em>, чтобы <em>Разрешить уведомления <%= platform.browser.capitalize %></em>.</li>
          <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em> рядом с <em>Веб-приложения</em>.</li>
          <li>Нажмите <em><%= icon_tag "bell-alert", alt: "колокольчик уведомлений" %></em> и выберите <em>Разрешить</em>.</li>
        </ol>
      <% when platform.safari? && platform.desktop? %>
        <h3>Включите уведомления для этого сайта.</h3>
        <ol>
          <li>Нажмите <em aria-label="меню Apple"></em> в левом верхнем углу.</li>
          <li>Нажмите <em>Системные настройки…</em></li>
          <li>Нажмите <em>Уведомления</em>.</li>
          <li>Нажмите <em><%= request.base_url %></em> в списке.</li>
          <li>Нажмите <em><%= icon_tag "switch", alt: "переключатель" %></em>, чтобы <em>Разрешить уведомления</em>.</li>
        </ol>
        <h3>Включите уведомления для <%= platform.browser.capitalize %>.</h3>
        <ol>
          <li>Нажмите <em><%= platform.browser.capitalize %></em> в левом верхнем углу.</li>
          <li>Нажмите <em>Настройки…</em></li>
          <li>Нажмите вкладку <em>Веб-сайты</em>.</li>
          <li>Нажмите <em>Уведомления</em> на боковой панели.</li>
          <li>Нажмите <em><%= request.base_url %></em> в списке.</li>
          <li>Выберите <em>Разрешить</em>.</li>
        </ol>
      <% else %>
        <p>Убедитесь, что уведомления включены для <em><%= root_url %></em> в настройках веб-браузера.</p>
    <% end %>
  </div>
<% end %>