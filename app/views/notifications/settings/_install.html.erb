<% unless (platform.chrome? && !platform.ios?) || (platform.firefox? && !platform.android?) %>
  <div class="notifications-help pwa__instructions hide-in-pwa">
    <h3><%= platform.safari? && platform.desktop? ? "…или установите" : "Установите " -%> Fizzy как веб-приложение.</h3>
    <% case
      when platform.edge? %>
        <ol>
          <li>Нажмите <em><%= icon_tag "install-edge", alt: "кнопка установки приложения" %></em>в адресной строке.</li>
          <li>Нажмите <em>Установить</em>.</li>
        </ol>
      <% when platform.chrome? && platform.android? %>
        <ol>
          <li>Нажмите кнопку меню <em><%= icon_tag "menu-dots-vertical", alt: "Дополнительные параметры" %></em>.</li>
          <li>Нажмите <em>Установить приложение</em> в меню.</li>
        </ol>
      <% when platform.firefox? && platform.android? %>
        <ol>
          <li>Нажмите кнопку меню <em><%= icon_tag "menu-dots-vertical", alt: "Дополнительные параметры" %></em>.</li>
          <li>Нажмите <em>Установить</em> в меню.</li>
        </ol>
      <% when platform.safari? && platform.desktop? %>
        <ol>
          <li>Нажмите <em>Файл</em> в левом верхнем углу.</li>
          <li>Нажмите <em>Добавить на панель Dock…</em></li>
        </ol>
      <% when (platform.safari? || platform.chrome?) && platform.ios? %>
        <p>Чтобы получать push-уведомления в <%= platform.browser.capitalize %> для <%= platform.operating_system %>, сначала установите Fizzy как веб-приложение.</p>
        <ol>
          <li>Нажмите <em><%= icon_tag "share", alt: "кнопка «Поделиться»" %></em></li>
          <li>Нажмите <em>Добавить на экран «Домой»</em>.</li>
        </ol>
      <% else %>
        <p>На некоторых платформах для получения push-уведомлений требуется установить Fizzy как веб-приложение.</p>
    <% end %>
  </div>
<% end %>