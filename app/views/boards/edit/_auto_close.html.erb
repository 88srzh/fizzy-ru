<%= turbo_frame_tag board, :entropy do %>
  <div class="margin-block-end">
    <h2 class="divider txt-large">Автозакрытие</h2>
    <p class="margin-none-block-start">Fizzy не позволяет устаревшим карточкам висеть вечно. Карточки автоматически перемещаются в «Не сейчас», если никто не обновляет, не комментирует и не перемещает карточку в течение…</p>
    <%= render "entropy/auto_close", model: board, url: board_entropy_path(board), disabled: !Current.user.can_administer_board?(board) %>
  </div>
<% end %>
