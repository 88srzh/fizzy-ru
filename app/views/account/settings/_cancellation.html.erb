<% if Current.account.cancellable? && Current.user.owner? %>
  <section class="settings__section settings__section--negative">
    <header>
      <h2 class="divider">Опасная зона</h2>
      <div>Удалите свой аккаунт и всё в нём, включая все доски и карточки.</div>
    </header>

    <div data-controller="dialog toggle-enable" data-dialog-modal-value="true">
      <button type="button" class="btn btn--negative" data-action="dialog#open">Удалить аккаунт...</button>

      <dialog class="dialog panel panel--wide shadow" data-dialog-target="dialog" data-action="close->toggle-enable#reset" style="--panel-size: 48ch;">
        <h2 class="margin-none txt-large txt-negative">Удалить аккаунт</h2>
        <div class="txt-align-start">
          <h3 class="margin-block-start margin-block-end-half txt-normal">Что произойдёт дальше:</h3>
          <ul class="list-unindented margin-block-start-half margin-block-end">
            <li>Ваш аккаунт <strong><%= Current.account.name %></strong> будет закрыт немедленно.</li>
            <li>Все пользователи, включая вас, потеряют доступ.</li>
            <% if Current.account.try(:active_subscription) %>
              <li>Ваша подписка будет отменена.</li>
            <% end %>
            <li>Все ваши данные будут безвозвратно удалены в течение 30&nbsp;дней.</li>
          </ul>

          <h3 class="margin-block-end-half txt-normal">Не забудьте экспортировать данные</h3>
          <p class="margin-block-start-half margin-block-end">
            <button type="button" class="btn btn--plain txt-link" data-controller="dispatch-event" data-dispatch-event-name-value="open-export" data-action="click->dialog#close click->dispatch-event#fire">Экспортируйте ваши данные</button> перед уходом. После удаления аккаунта вы не сможете это сделать.
          </p>
        </div>

        <label class="flex gap justify-start txt-align-start margin-block-end-double">
          <input type="checkbox" class="checkbox" data-toggle-enable-target="checkbox" data-action="change->toggle-enable#toggle">
          Я прочитал(а) вышеизложенное и хочу продолжить
        </label>

        <div class="flex gap justify-center">
          <button type="button" class="btn" autofocus data-action="dialog#close">Не сейчас</button>
          <%= button_to "Удалить мой аккаунт", account_cancellation_path,
              method: :post,
              class: "btn btn--negative",
              disabled: true,
              form: { data: { action: "submit->dialog#close", turbo: false } },
              data: { toggle_enable_target: "element" } %>
        </div>
      </dialog>
    </div>
  </section>
<% end %>
