<% @page_title = "Импорт аккаунта" %>
<div class="panel panel--centered flex flex-column gap" style="--panel-size: 54ch;">
  <header>
    <h1 class="txt-x-large font-weight-black txt-tight-lines margin-block-end-none">Импорт аккаунта Fizzy</h1>

    <% if Fizzy.saas? %>
      <div class="font-weight-semibold margin-block-end">Запускаете Fizzy на своём сервере и хотите, чтобы мы разместили его на <a class="txt-ink txt-underline" href="https://fizzy.do" target="_blank" rel="noopener noreferrer">fizzy.do</a>?</div>
      <div>Экспортируйте ваш self-hosted аккаунт, затем загрузите .zip-файл ниже.</div>
    <% else %>
      <div class="font-weight-semibold margin-block-end">Готовы разместить Fizzy на своём сервере?</div>
      <div>Экспортируйте ваш <a class="txt-ink txt-underline" href="https://fizzy.do" target="_blank" rel="noopener noreferrer">fizzy.do</a> аккаунт, затем загрузите .zip-файл ниже.</div>
    <% end %>
  </header>

  <%= form_with url: account_imports_path, class: "flex flex-column gap", data: { controller: "form upload-preview" }, multipart: true do |form| %>
    <label class="btn input--upload">
      <div data-upload-preview-target="placeholder">Выберите файл…</div>
      <div data-upload-preview-target="fileName" hidden></div>
      <%= form.file_field :file, accept: ".zip", required: true, data: { action: "upload-preview#previewFileName", upload_preview_target: "input" } %>
    </label>

    <button type="submit" class="btn btn--link center" data-form-target="submit">
      <span>Начать импорт →</span>
    </button>
  <% end %>

  <p class="txt-small">Если возникнут проблемы или нужна помощь, просто <a href="mailto:support@fizzy.do" class="txt-ink txt-underline">напишите нам на email</a>.</p>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
