<% @page_title = "Ссылка истекла" %>

<div class="panel panel--centered center flex flex-column gap-half" style="--panel-size: 50ch;">
  <h1 class="txt-x-large font-weight-black margin-none">
    <%= @page_title %>
  </h1>
  <p class="margin-none-block-start margin-block-end-half">
    Эта ссылка для подтверждения email больше не действительна — они истекают через 30 минут. Попробуйте снова.
  </p>

  <%= link_to "Сменить мой email-адрес", new_user_email_address_path(user_id: @user, script_name: @user.account.slug), class: "btn btn--link center" %>

  <p class="txt-small txt-subtle">
    Если застрянете, <%= mail_to "support@fizzy.do", "напишите нам на email" %>, и мы поможем.
  </p>
</div>