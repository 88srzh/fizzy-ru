<% @page_title = "Подтвердите новый email-адрес" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= back_link_to "Мой профиль", edit_user_path(@user, script_name: @user.account.slug), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
  </div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <h1 class="txt-x-large font-weight-black margin-none">Проверьте email</h1>
  <p class="margin-none">Мы только что отправили письмо на <strong><%= params[:email_address] %></strong></p>
  <p class="margin-none-block-start margin-block-end-half">Перейдите по ссылке в письме, чтобы подтвердить, что это email, который вы хотите использовать с Fizzy в дальнейшем.</p>

  <%= link_to "Готово", edit_user_path(@user, script_name: @user.account.slug), class: "btn btn--link center" %>
</div>