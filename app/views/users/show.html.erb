<% @page_title = @user.name %>

<div class="settings settings--profile">
  <div class="settings__panel panel shadow txt-align-center">
    <div class="flex flex-column gap position-relative">
      <% if Current.user == @user %>
        <%= link_to edit_user_path(@user), class: "user-edit-link btn", data: { controller: "tooltip" } do %>
          <%= icon_tag "pencil" %>
          <span class="for-screen-reader">Редактировать профиль</span>
        <% end %>
      <% end %>

      <div class="avatar txt-xx-large center fill-white btn--circle hide-focus-ring">
        <%= image_tag user_avatar_path(@user), alt: "Аватар профиля для #{@user.name}" %>
      </div>

      <div class="flex flex-column gap-half margin-block-end">
        <h1 class="txt-x-large margin-none"><%= @user.name %></h1>
        <div class="txt-medium">
          <% if !@user.active? %>
            <%= @user.name %> больше не в этом аккаунте
          <% elsif !@user.verified? %>
            Не подтверждён
            <div class="txt-small txt-tinted">На этот email отправлен код входа, но пользователь ещё не вошёл, чтобы подтвердить личность.</div>
          <% else %>
            <%= mail_to @user.identity.email_address %>
          <% end %>
        </div>
      </div>

      <% if @user.verified? %>
        <div class="flex-inline center justify-center flex-wrap gap">
          <% if Current.user == @user %>
            <%= link_to "Какие карточки назначены вам?",
                  cards_path(assignee_ids: [ @user.id ], sorted_by: "newest"), class: "btn btn--link", data: { turbo_frame: "_top" } %>
            <%= link_to "Какие карточки добавили вы?",
                  cards_path(creator_ids: [ @user.id ], sorted_by: "newest"), class: "btn btn--link", data: { turbo_frame: "_top" } %>
          <% else %>
            <%= link_to "Какие карточки назначены #{@user.first_name}?",
                  cards_path(assignee_ids: [ @user.id ], sorted_by: "newest"), class: "btn btn--link", data: { turbo_frame: "_top" } %>
            <%= link_to "Какие карточки добавил #{@user.first_name}?",
                  cards_path(creator_ids: [ @user.id ], sorted_by: "newest"), class: "btn btn--link", data: { turbo_frame: "_top" } %>
          <% end %>
        </div>
      <% end %>

      <% if Current.user == @user %>
        <div class="flex-inline justify-center flex-wrap gap full-width hide-on-native">
          <hr class="separator--horizontal full-width margin-block-start-double" style="--border-color: var(--color-ink-light);" aria-hidden="true">

          <%= link_to my_passkeys_path, class: "btn txt-x-small" do %>
            <%= icon_tag "authentication" %>
            <span>Управление ключами доступа</span>
          <% end %>

          <%= button_to session_path(script_name: nil), method: :delete, class: "btn txt-x-small", form: { data: { turbo: false, controller: "clear-offline-cache", action: "submit->clear-offline-cache#clearCache" } } do %>
            <span>Выйти из Fizzy на этом устройстве</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if Current.user == @user %>
    <div class="settings__panel panel shadow hide-on-native">
      <%= render "users/theme" %>
      <%= render "users/transfer", user: @user %>
      <%= render "users/connected_apps" if Current.identity.access_tokens.grants.unlapsed.exists? %>
      <%= render "users/access_tokens" %>
      <%= render "users/data_export" %>
    </div>
  <% end %>
</div>

<% if @user.verified? %>
  <%= turbo_frame_tag "user_events", src: user_events_path(@user) %>
<% end %>