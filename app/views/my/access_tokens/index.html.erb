<% @page_title = "Персональные токены доступа" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <% if Current.user %>
      <%= back_link_to "Мой профиль", user_path(Current.user), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
    <% else %>
      <%= back_link_to "Меню", session_menu_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
    <% end %>
  </div>

  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
<% end %>

<section class="panel panel--wide shadow center webhooks">
  <% if @access_tokens.any? %>
    <p class="margin-none-block-start">Токены, которые вы создали и которые можно использовать для доступа к Fizzy API.</p>
    <table class="access-tokens margin-block-end-double max-width txt-small">
      <thead>
        <tr>
          <th>Описание</th>
          <th>Права</th>
          <th>Создан</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "my/access_tokens/access_token", collection: @access_tokens %>
      </tbody>
    </table>
  <% else %>
    <p class="margin-none-block-start">Персональные токены доступа можно использовать как пароль для доступа к Fizzy developer API. У вас может быть сколько угодно токенов, и вы можете отозвать доступ к каждому из них в любой момент.</p>
  <% end %>

  <%= link_to new_my_access_token_path, class: "btn btn--link" do %>
    <%= icon_tag "add" %>
    <span>Создать новый токен доступа</span>
  <% end %>
</section>