<% @page_title = "Подключённые приложения" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <% if Current.user %>
      <%= back_link_to "Мой профиль", user_path(Current.user), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
    <% else %>
      <%= back_link_to "Меню", session_menu_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
    <% end %>
  </div>

  <h1 class="header__title"><%= @page_title %></h1>
<% end %>

<section class="connected-apps panel panel--wide shadow center txt-align-start">
  <% if @connected_apps.any? %>
    <p class="margin-none-block-start">Приложения, которым вы дали доступ к Fizzy от вашего имени. Каждое из них может делать то же, что и вы, с указанным доступом. Не узнаёте какое-то? Отключите его, и доступ прекратится сразу.</p>

    <% connected_app_groups(@connected_apps).each do |kind, heading, apps| %>
      <section class="connected-apps__group" aria-labelledby="<%= "connected_apps_#{kind}" %>">
        <h2 id="<%= "connected_apps_#{kind}" %>" class="divider txt-medium margin-none"><%= heading %></h2>

        <% apps.each do |client, tokens| %>
          <%= render "my/connected_apps/connected_app", client: client, tokens: tokens, webhooks: @webhooks_by_client.fetch(client.id, []) %>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <div class="connected-apps__empty flex flex-column gap-half">
      <p class="margin-none"><strong>Пока ничего не подключено.</strong></p>
      <p class="txt-small txt-subtle margin-none">AI-ассистенты и другие приложения, которые вы подключите к Fizzy, будут отображаться здесь, чтобы вы могли видеть, что каждое из них умеет делать, и отключать их, когда захотите.</p>
    </div>
  <% end %>
</section>