<% remote_hosts = oauth_client_remote_hosts(client) %>

<article class="connected-app" id="<%= dom_id(client, :connected_app) %>">
  <div class="connected-app__details flex flex-column">
    <%# A self-registered app goes by the name it gave itself, since that's the
        name people know it by, but never without where its access goes %>
    <h3 class="connected-app__name txt-medium margin-none" id="<%= dom_id(client, :connected_app_name) %>"><bdi><%= oauth_client_self_name(client) %></bdi></h3>

    <% if client.dynamically_registered? %>
      <p class="txt-x-small txt-subtle margin-none">
        <% if remote_hosts.any? %>
          Имя задано приложением на <%= remote_hosts.to_sentence(two_words_connector: " или ", last_word_connector: " или ") %>
        <% else %>
          Имя задано приложением на вашем устройстве
        <% end %>
      </p>
    <% elsif client.metadata_document? %>
      <p class="txt-x-small txt-subtle margin-none">Имя задано приложением на <%= URI.parse(client.client_id).host %></p>
    <% elsif client.trusted? %>
      <p class="txt-x-small txt-subtle margin-none">Сделано 37signals</p>
    <% end %>

    <% oauth_connected_app_reach(tokens).each do |permission, accounts| %>
      <p class="connected-app__access txt-small margin-none">
        <strong><%= oauth_access_label(permission) %></strong>, <% if accounts %>в <%= to_sentence(accounts.map { |account| tag.bdi(account.name) }) %><% else %>во всех аккаунтах, в которых вы состоите<% end %>
      </p>
    <% end %>

    <%# updated_at moves each time the app renews its access %>
    <p class="txt-x-small txt-subtle margin-none">
      Подключено <%= local_datetime_tag tokens.map(&:created_at).min, style: :date %>
      &middot; доступ последний раз обновлён <%= local_datetime_tag tokens.map(&:updated_at).max, style: :daysago %>
      <% if tokens.many? %>&middot; <%= pluralize(tokens.size, "connection") %><% end %>
    </p>
  </div>

  <div class="connected-app__disconnect" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
    <button type="button" class="btn txt-negative borderless txt-small" data-action="dialog#open" aria-describedby="<%= dom_id(client, :connected_app_name) %>">
      <%= icon_tag "trash" %>
      <span>Отключить</span>
    </button>

    <dialog class="dialog panel fill-white shadow gap flex-column" style="--panel-size: 44ch" data-dialog-target="dialog" aria-labelledby="<%= dom_id(client, :disconnect_title) %>">
      <h3 class="txt-large txt-bold margin-none" id="<%= dom_id(client, :disconnect_title) %>">Отключить <bdi><%= oauth_client_self_name(client) %></bdi>?</h3>
      <p class="txt-medium margin-none">Он сразу потеряет доступ к Fizzy. Чтобы использовать снова, подключите его заново.</p>

      <%= form_with url: my_connected_app_path(client), method: :delete, class: "flex flex-column gap" do |form| %>
        <% if webhooks.any? %>
          <div class="txt-align-start">
            <p class="margin-none">Он настроил <%= webhooks.one? ? "этот вебхук" : "эти вебхуки" %>, которые продолжат работать, пока вы их не удалите:</p>
            <ul class="margin-block-half">
              <% webhooks.each do |webhook| %>
                <li>
                  <strong><%= webhook.name %></strong> на <%= webhook.board.name %><%= " в #{webhook.account.name}" unless webhook.account == Current.account %>
                  <%= hidden_field_tag "webhook_ids[]", webhook.id, id: nil %>
                </li>
              <% end %>
            </ul>

            <label class="flex gap-half align-center justify-start">
              <%= check_box_tag :remove_webhooks, "1", false, class: "checkbox", id: dom_id(client, :remove_webhooks) %>
              Также удалить <%= webhooks.one? ? "его" : "их" %>
            </label>
          </div>
        <% end %>

        <div class="flex gap-half justify-center">
          <button type="button" class="btn" data-action="dialog#close">Отмена</button>
          <%= form.button "Отключить", class: "btn txt-negative" %>
        </div>
      <% end %>
    </dialog>
  </div>
</article>