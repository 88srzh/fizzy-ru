{
  "name": <%= [ "Fizzy", Rails.env.production? ? nil : Rails.env ].compact.join(" - ").to_json.html_safe %>,
  "icons": [
    {
      "src": "/app-icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/app-icon.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/app-icon-192-maskable.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "description": "Превратите главные задачи ваших проектов в карточки",
  "categories": ["bugs", "business", "productivity"],
  "shortcuts": [
    {
      "name": "Уведомления",
      "description": "Просмотрите свежие уведомления",
      "url": "<%= notifications_path %>",
      "icons": [{ "src": "<%= image_url("bell.svg") %>", "sizes": "any" }]
    },
    {
      "name": "Последняя активность",
      "description": "Узнайте, что нового",
      "url": "<%= root_path %>",
      "icons": [{ "src": "<%= image_url("activity.svg") %>", "sizes": "any" }]
    }
  ]
}
